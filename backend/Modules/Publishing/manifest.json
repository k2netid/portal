{
  "name": "Publishing",
  "slug": "publishing",
  "version": "1.0.0",
  "description": "Console content publishing \u2014 articles, pages, revisions, comments, and SEO tools. Depends on Library.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "publishing-settings",
  "dependencies": {
    "library": ">=1.0.0"
  },
  "suggests": {
    "media": ">=1.0.0",
    "layout": ">=1.1.0"
  },
  "features": [
    {
      "slug": "contents",
      "name": "Contents",
      "description": "Articles and pages with editorial workflow",
      "category": "marketing"
    },
    {
      "slug": "comments",
      "name": "Comments",
      "description": "Comment moderation",
      "category": "marketing"
    },
    {
      "slug": "seo",
      "name": "SEO tools",
      "description": "Per-content SEO analysis helpers",
      "category": "marketing"
    }
  ],
  "capabilities": {
    "contents": {
      "name": "Published Contents",
      "description": "Articles and pages with editorial and publishing workflow",
      "actions": {
        "view": {
          "permission": "view content",
          "label": "View Content",
          "label_key": "system.capabilities.publishing.contents.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author", "operator"],
          "oauth_scope": "publishing:read"
        },
        "create": {
          "permission": "create content",
          "label": "Create Content Draft",
          "label_key": "system.capabilities.publishing.contents.create",
          "action_type": "create",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "publishing:write"
        },
        "edit": {
          "permission": "edit content",
          "label": "Edit Content",
          "label_key": "system.capabilities.publishing.contents.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "publishing:write"
        },
        "delete": {
          "permission": "delete content",
          "label": "Delete Content",
          "label_key": "system.capabilities.publishing.contents.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:delete"
        },
        "approve": {
          "permission": "approve content",
          "label": "Approve Content",
          "label_key": "system.capabilities.publishing.contents.approve",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:approve"
        },
        "publish": {
          "permission": "publish content",
          "label": "Publish Content",
          "label_key": "system.capabilities.publishing.contents.publish",
          "action_type": "execute",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:publish"
        },
        "manage": {
          "permission": "manage content",
          "label": "Manage All Content",
          "label_key": "system.capabilities.publishing.contents.manage",
          "action_type": "admin",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:manage"
        }
      }
    },
    "templates": {
      "name": "Content Templates",
      "description": "Reusable page and article layout templates",
      "actions": {
        "view": {
          "permission": "view content templates",
          "label": "View Templates",
          "label_key": "system.capabilities.publishing.templates.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "publishing:read"
        },
        "edit": {
          "permission": "edit content templates",
          "label": "Edit Templates",
          "label_key": "system.capabilities.publishing.templates.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:write"
        },
        "delete": {
          "permission": "delete content templates",
          "label": "Delete Templates",
          "label_key": "system.capabilities.publishing.templates.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:delete"
        },
        "manage": {
          "permission": "manage content templates",
          "label": "Manage Templates",
          "label_key": "system.capabilities.publishing.templates.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "publishing:manage"
        }
      }
    },
    "comments": {
      "name": "Comments Moderation",
      "description": "Reader comments moderation and approval",
      "actions": {
        "view": {
          "permission": "view comments",
          "label": "View Comments",
          "label_key": "system.capabilities.publishing.comments.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author", "operator"],
          "oauth_scope": "comments:read"
        },
        "manage": {
          "permission": "manage comments",
          "label": "Moderate & Manage Comments",
          "label_key": "system.capabilities.publishing.comments.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "comments:manage"
        }
      }
    },
    "seo": {
      "name": "SEO & Metadata",
      "description": "Search engine optimization and meta tags",
      "actions": {
        "view": {
          "permission": "view seo",
          "label": "View SEO Metadata",
          "label_key": "system.capabilities.publishing.seo.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "seo:read"
        },
        "manage": {
          "permission": "manage seo",
          "label": "Manage SEO Metadata",
          "label_key": "system.capabilities.publishing.seo.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "seo:manage"
        }
      }
    }
  },

  "permissions": [
    "view content",
    "create content",
    "edit content",
    "delete content",
    "approve content",
    "publish content",
    "manage content",
    "view comments",
    "manage comments",
    "view seo",
    "manage seo",
    "view content templates",
    "manage content templates",
    "edit content templates",
    "delete content templates"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Publishing\\Database\\Seeders\\PublishingPermissionSeeder",
      "Modules\\Publishing\\Database\\Seeders\\PublishingDemoContentSeeder"
    ]
  },
  "member_area": {
    "depends_on": ["member"],
    "capabilities": ["member.bookmarks", "member.comments"],
    "nav": [
      {
        "slug": "bookmarks",
        "label_key": "member.nav.bookmarks",
        "route": "member.bookmarks",
        "order": 40,
        "requires_verified": true,
        "capability": "member.bookmarks"
      },
      {
        "slug": "comments",
        "label_key": "member.nav.comments",
        "route": "member.comments",
        "order": 50,
        "requires_verified": true,
        "capability": "member.comments"
      }
    ],
    "widgets": [
      {
        "slug": "recent-bookmarks",
        "slot": "dashboard",
        "order": 10,
        "requires_verified": true,
        "capability": "member.bookmarks"
      },
      {
        "slug": "recent-comments",
        "slot": "dashboard",
        "order": 20,
        "requires_verified": true,
        "capability": "member.comments"
      }
    ]
  }
}
