{
  "name": "JA-Mail",
  "slug": "mail",
  "version": "1.0.0",
  "description": "Console outbound webmail: compose/send via SMTP, multi-account credentials, templates, and scheduled dispatch",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "communications",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "mail",
  "features": [
    {
      "name": "Webmail Client",
      "slug": "webmail-client",
      "description": "Local mailbox UI — inbox, sent, drafts, trash (local index; not IMAP sync)",
      "category": "business"
    },
    {
      "name": "Multi-Account SMTP",
      "slug": "multi-account",
      "description": "Connect personal SMTP accounts with encrypted credentials and switching",
      "category": "business"
    },
    {
      "name": "Canned Responses",
      "slug": "templates",
      "description": "Reusable quick-reply email snippets",
      "category": "business"
    },
    {
      "name": "Scheduled Dispatcher",
      "slug": "scheduled-send",
      "description": "Schedule outbound emails via mail:process-scheduled",
      "category": "business"
    }
  ],
  "capabilities": {
    "webmail": {
      "name": "Webmail & Outbound Communications",
      "description": "Outbound email dispatch, encrypted SMTP credentials, and scheduled messaging",
      "actions": {
        "use": {
          "permission": "use mail",
          "label": "Use Webmail",
          "label_key": "system.capabilities.mail.webmail.use",
          "action_type": "execute",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "mail:send"
        },
        "manage_personal": {
          "permission": "manage personal mail account",
          "label": "Manage Personal Mail Account",
          "label_key": "system.capabilities.mail.webmail.manage_personal",
          "action_type": "update",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "mail:account"
        },
        "manage_multi": {
          "permission": "manage multi mail accounts",
          "label": "Manage System Multi-Mail Accounts",
          "label_key": "system.capabilities.mail.webmail.manage_multi",
          "action_type": "manage",
          "is_dangerous": true,
          "default_roles": ["admin"],
          "oauth_scope": "mail:manage"
        }
      }
    }
  },
  "permissions": [
    "use mail",
    "manage personal mail account",
    "manage multi mail accounts"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Mail\\Database\\Seeders\\MailPermissionSeeder"
    ]
  }
}
