{
  "name": "Forms",
  "slug": "forms",
  "version": "1.0.0",
  "description": "Console dynamic forms with field builder, submissions inbox, export, and public embed API.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "forms",
  "features": [
    {
      "slug": "form-builder",
      "name": "Form Builder",
      "description": "Design multi-field forms with validation",
      "category": "marketing"
    },
    {
      "slug": "submissions",
      "name": "Submissions",
      "description": "Inbox, export, and analytics for form responses",
      "category": "marketing"
    },
    {
      "slug": "public-embed",
      "name": "Public Embed",
      "description": "Public submit API for themes and builder blocks",
      "category": "utility"
    }
  ],
  "capabilities": {
    "forms": {
      "name": "Dynamic Forms & Submissions",
      "description": "Online form builder, submission management, and response inbox",
      "actions": {
        "view": {
          "permission": "view forms",
          "label": "View Forms & Submissions",
          "label_key": "system.capabilities.forms.forms.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "forms:read"
        },
        "create": {
          "permission": "create forms",
          "label": "Create Forms",
          "label_key": "system.capabilities.forms.forms.create",
          "action_type": "create",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "forms:write"
        },
        "edit": {
          "permission": "edit forms",
          "label": "Edit Forms",
          "label_key": "system.capabilities.forms.forms.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "forms:write"
        },
        "delete": {
          "permission": "delete forms",
          "label": "Delete Forms & Submissions",
          "label_key": "system.capabilities.forms.forms.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin"],
          "oauth_scope": "forms:delete"
        },
        "manage": {
          "permission": "manage forms",
          "label": "Manage All Forms",
          "label_key": "system.capabilities.forms.forms.manage",
          "action_type": "manage",
          "default_roles": ["admin"],
          "oauth_scope": "forms:manage"
        }
      }
    }
  },
  "permissions": [
    "view forms",
    "create forms",
    "edit forms",
    "delete forms",
    "manage forms"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Forms\\Database\\Seeders\\FormsPermissionSeeder",
      "Modules\\Forms\\Database\\Seeders\\ContactFormSeeder"
    ]
  },
  "member_area": {
    "depends_on": ["member"],
    "capabilities": ["member.submissions"],
    "nav": [
      {
        "slug": "submissions",
        "label_key": "member.nav.submissions",
        "route": "member.submissions",
        "order": 70,
        "capability": "member.submissions"
      }
    ],
    "widgets": [
      {
        "slug": "recent-submissions",
        "slot": "dashboard",
        "order": 40,
        "capability": "member.submissions"
      }
    ]
  }
}
