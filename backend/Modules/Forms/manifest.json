{
  "name": "Forms",
  "slug": "forms",
  "version": "1.0.0",
  "description": "Console dynamic forms with field builder, submissions inbox, export, and public embed API.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "forms",
  "features": [
    {
      "slug": "form-builder",
      "name": "Form Builder",
      "description": "Design multi-field forms with validation",
      "category": "marketing"
    },
    {
      "slug": "submissions",
      "name": "Submissions",
      "description": "Inbox, export, and analytics for form responses",
      "category": "marketing"
    },
    {
      "slug": "public-embed",
      "name": "Public Embed",
      "description": "Public submit API for themes and builder blocks",
      "category": "utility"
    }
  ],
  "permissions": [
    "view forms",
    "create forms",
    "edit forms",
    "delete forms",
    "manage forms"
  ],
  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Forms\\Database\\Seeders\\FormsPermissionSeeder",
      "Modules\\Forms\\Database\\Seeders\\ContactFormSeeder"
    ]
  },
  "member_area": {
    "depends_on": ["member"],
    "capabilities": ["member.submissions"],
    "nav": [
      {
        "slug": "submissions",
        "label_key": "member.nav.submissions",
        "route": "member.submissions",
        "order": 70,
        "capability": "member.submissions"
      }
    ],
    "widgets": [
      {
        "slug": "recent-submissions",
        "slot": "dashboard",
        "order": 40,
        "capability": "member.submissions"
      }
    ]
  }
}
