{
  "name": "Library",
  "slug": "library",
  "version": "1.0.0",
  "description": "Taxonomy library \u2014 categories, tags, custom fields, and field groups for content packs.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "library",
  "features": [
    {
      "slug": "categories",
      "name": "Categories",
      "description": "Hierarchical content categories",
      "category": "utility"
    },
    {
      "slug": "tags",
      "name": "Tags",
      "description": "Content tagging",
      "category": "utility"
    },
    {
      "slug": "custom-fields",
      "name": "Custom Fields",
      "description": "Reusable field definitions and groups",
      "category": "utility"
    }
  ],
  "capabilities": {
    "categories": {
      "name": "Taxonomy Categories",
      "description": "Hierarchical content categories for articles and media",
      "actions": {
        "view": {
          "permission": "view categories",
          "label": "View Categories",
          "label_key": "system.capabilities.library.categories.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author", "operator"],
          "oauth_scope": "library:read"
        },
        "manage": {
          "permission": "manage categories",
          "label": "Manage Categories",
          "label_key": "system.capabilities.library.categories.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "library:write"
        }
      }
    },
    "tags": {
      "name": "Content Tags",
      "description": "Tagging and keywords for content discoverability",
      "actions": {
        "manage": {
          "permission": "manage tags",
          "label": "Manage Tags",
          "label_key": "system.capabilities.library.tags.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "library:write"
        }
      }
    }
  },

  "permissions": [
    "view categories",
    "manage categories",
    "manage tags"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Library\\Database\\Seeders\\LibraryPermissionSeeder"
    ]
  }
}
