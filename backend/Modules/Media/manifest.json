{
  "name": "Media",
  "slug": "media",
  "version": "1.0.0",
  "description": "Console media library with uploads, folders, thumbnails, and usage tracking. Soft-integrates with File Manager and Publishing pickers.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "media",
  "suggests": {
    "library": ">=1.0.0"
  },
  "features": [
    {
      "slug": "media-library",
      "name": "Media Library",
      "description": "Browse, upload, and organize media files",
      "category": "utility"
    },
    {
      "slug": "media-picker",
      "name": "Media Picker",
      "description": "Embeddable picker for Publishing and other packs",
      "category": "utility"
    }
  ],
  "capabilities": {
    "media": {
      "name": "Media Library",
      "description": "Upload images, documents, organize folders, and picker integration",
      "actions": {
        "view": {
          "permission": "view media",
          "label": "View Media",
          "label_key": "system.capabilities.media.media.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "author", "operator"],
          "oauth_scope": "media:read"
        },
        "upload": {
          "permission": "upload media",
          "label": "Upload Media",
          "label_key": "system.capabilities.media.media.upload",
          "action_type": "create",
          "default_roles": ["admin", "editor", "author", "operator"],
          "oauth_scope": "media:write"
        },
        "edit": {
          "permission": "edit media",
          "label": "Edit Media Details",
          "label_key": "system.capabilities.media.media.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor", "author"],
          "oauth_scope": "media:write"
        },
        "delete": {
          "permission": "delete media",
          "label": "Delete Media",
          "label_key": "system.capabilities.media.media.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "media:delete"
        },
        "manage": {
          "permission": "manage media",
          "label": "Manage Media & Folders",
          "label_key": "system.capabilities.media.media.manage",
          "action_type": "manage",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "media:manage"
        }
      }
    }
  },

  "permissions": [
    "view media",
    "upload media",
    "edit media",
    "delete media",
    "manage media"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Media\\Database\\Seeders\\MediaPermissionSeeder"
    ]
  }
}
