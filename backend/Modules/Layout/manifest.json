{
  "name": "Layout",
  "slug": "layout",
  "version": "1.1.0",
  "description": "Site layout pack \u2014 menus, widgets, redirects, themes, visual builder, and block renderer for Publishing.",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "cms",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0-beta"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "layout",
  "dependencies": {
    "publishing": ">=1.0.0"
  },
  "suggests": {
    "media": ">=1.0.0",
    "forms": ">=1.0.0"
  },
  "contribution_points": {
    "widgets": [
      { "type": "html", "name": "HTML", "areas": ["sidebar", "footer"] },
      { "type": "text", "name": "Text", "areas": ["sidebar", "footer"] },
      { "type": "content_list", "name": "Content list", "areas": ["sidebar", "footer"] },
      { "type": "menu", "name": "Navigation menu", "areas": ["sidebar", "footer"] },
      { "type": "form", "name": "Form", "areas": ["sidebar", "footer"] },
      { "type": "recent_posts", "name": "Recent posts", "areas": ["sidebar"] },
      { "type": "categories", "name": "Categories", "areas": ["sidebar"] },
      { "type": "custom", "name": "Custom", "areas": ["sidebar", "footer"] }
    ]
  },
  "features": [
    {
      "slug": "menus",
      "name": "Menus",
      "description": "Build nested site navigation menus",
      "category": "marketing"
    },
    {
      "slug": "widgets",
      "name": "Widgets",
      "description": "Manage sidebar and footer widgets",
      "category": "marketing"
    },
    {
      "slug": "redirects",
      "name": "Redirects",
      "description": "301/302 URL redirects and aliases",
      "category": "utility"
    },
    {
      "slug": "themes",
      "name": "Themes",
      "description": "Install, activate, and customize frontend themes",
      "category": "marketing"
    },
    {
      "slug": "visual-builder",
      "name": "Visual Builder",
      "description": "Drag-and-drop page and site block editor",
      "category": "marketing"
    }
  ],
  "capabilities": {
    "menus": {
      "name": "Navigation Menus",
      "description": "Build and manage multi-level navigation menus for header, footer, and sidebar",
      "actions": {
        "view": {
          "permission": "view menus",
          "label": "View Menus",
          "label_key": "system.capabilities.layout.menus.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "layout:read"
        },
        "create": {
          "permission": "create menus",
          "label": "Create Menus",
          "label_key": "system.capabilities.layout.menus.create",
          "action_type": "create",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "edit": {
          "permission": "edit menus",
          "label": "Edit Menus",
          "label_key": "system.capabilities.layout.menus.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "delete": {
          "permission": "delete menus",
          "label": "Delete Menus",
          "label_key": "system.capabilities.layout.menus.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:delete"
        },
        "manage": {
          "permission": "manage menus",
          "label": "Manage All Menus",
          "label_key": "system.capabilities.layout.menus.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:manage"
        }
      }
    },
    "widgets": {
      "name": "Widgets Area",
      "description": "Manage block components and widgets across layout regions",
      "actions": {
        "view": {
          "permission": "view widgets",
          "label": "View Widgets",
          "label_key": "system.capabilities.layout.widgets.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "layout:read"
        },
        "create": {
          "permission": "create widgets",
          "label": "Create Widgets",
          "label_key": "system.capabilities.layout.widgets.create",
          "action_type": "create",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "edit": {
          "permission": "edit widgets",
          "label": "Edit Widgets",
          "label_key": "system.capabilities.layout.widgets.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "delete": {
          "permission": "delete widgets",
          "label": "Delete Widgets",
          "label_key": "system.capabilities.layout.widgets.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:delete"
        },
        "manage": {
          "permission": "manage widgets",
          "label": "Manage All Widgets",
          "label_key": "system.capabilities.layout.widgets.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:manage"
        }
      }
    },
    "redirects": {
      "name": "URL Redirects",
      "description": "Manage 301 and 302 URL redirects and path aliases",
      "actions": {
        "view": {
          "permission": "view redirects",
          "label": "View Redirects",
          "label_key": "system.capabilities.layout.redirects.view",
          "action_type": "read",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:read"
        },
        "create": {
          "permission": "create redirects",
          "label": "Create Redirects",
          "label_key": "system.capabilities.layout.redirects.create",
          "action_type": "create",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "edit": {
          "permission": "edit redirects",
          "label": "Edit Redirects",
          "label_key": "system.capabilities.layout.redirects.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "delete": {
          "permission": "delete redirects",
          "label": "Delete Redirects",
          "label_key": "system.capabilities.layout.redirects.delete",
          "action_type": "delete",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:delete"
        },
        "manage": {
          "permission": "manage redirects",
          "label": "Manage All Redirects",
          "label_key": "system.capabilities.layout.redirects.manage",
          "action_type": "manage",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:manage"
        }
      }
    },
    "themes": {
      "name": "Themes & Customizer",
      "description": "Install, activate, and customize frontend public themes",
      "actions": {
        "view": {
          "permission": "view themes",
          "label": "View Themes",
          "label_key": "system.capabilities.layout.themes.view",
          "action_type": "read",
          "default_roles": ["admin", "editor", "operator"],
          "oauth_scope": "layout:read"
        },
        "upload": {
          "permission": "upload themes",
          "label": "Upload Themes",
          "label_key": "system.capabilities.layout.themes.upload",
          "action_type": "create",
          "is_dangerous": true,
          "default_roles": ["admin"],
          "oauth_scope": "layout:admin"
        },
        "edit": {
          "permission": "edit themes",
          "label": "Customize Themes",
          "label_key": "system.capabilities.layout.themes.edit",
          "action_type": "update",
          "default_roles": ["admin", "editor"],
          "oauth_scope": "layout:write"
        },
        "delete": {
          "permission": "delete themes",
          "label": "Delete Themes",
          "label_key": "system.capabilities.layout.themes.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["admin"],
          "oauth_scope": "layout:delete"
        },
        "manage": {
          "permission": "manage themes",
          "label": "Manage All Themes",
          "label_key": "system.capabilities.layout.themes.manage",
          "action_type": "admin",
          "is_dangerous": true,
          "default_roles": ["admin"],
          "oauth_scope": "layout:manage"
        }
      }
    }
  },

  "permissions": [
    "view menus",
    "create menus",
    "edit menus",
    "delete menus",
    "manage menus",
    "view widgets",
    "create widgets",
    "edit widgets",
    "delete widgets",
    "manage widgets",
    "view redirects",
    "create redirects",
    "edit redirects",
    "delete redirects",
    "manage redirects",
    "view themes",
    "upload themes",
    "edit themes",
    "delete themes",
    "manage themes"
  ],

  "lifecycle": {
    "preserve_data_on_deactivate": true,
    "seeders_on_activate": [
      "Modules\\Layout\\Database\\Seeders\\LayoutPermissionSeeder"
    ]
  }
}
