{
  "name": "Core",
  "slug": "core",
  "version": "1.0.0",
  "description": "Platform kernel — System, Security, Identity, and Infra (always active)",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "platform",
  "is_core": true,
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0"
  },
  "license": "Commercial Enterprise",
  "license_tier": "pro_plus",
  "capabilities": {
    "profile": {
      "name": "User Profile",
      "description": "Personal account profile and credentials",
      "actions": {
        "view": {
          "permission": "view profile",
          "label": "View Own Profile",
          "label_key": "system.capabilities.core.profile.view",
          "action_type": "read",
          "default_roles": ["super", "system-admin", "admin", "security-officer", "operator", "editor", "author", "staff", "member"],
          "oauth_scope": "profile:read"
        },
        "edit": {
          "permission": "edit profile",
          "label": "Edit Own Profile",
          "label_key": "system.capabilities.core.profile.edit",
          "action_type": "update",
          "default_roles": ["super", "system-admin", "admin", "security-officer", "operator", "editor", "author", "staff", "member"],
          "oauth_scope": "profile:write"
        }
      }
    },
    "users": {
      "name": "User Management",
      "description": "Manage user accounts, verification, and status",
      "actions": {
        "view": {
          "permission": "view users",
          "label": "View Users",
          "label_key": "system.capabilities.core.users.view",
          "action_type": "read",
          "default_roles": ["super", "system-admin", "admin", "operator"],
          "oauth_scope": "users:read"
        },
        "create": {
          "permission": "create users",
          "label": "Create Users",
          "label_key": "system.capabilities.core.users.create",
          "action_type": "create",
          "default_roles": ["super", "system-admin", "admin", "operator"],
          "oauth_scope": "users:write"
        },
        "edit": {
          "permission": "edit users",
          "label": "Edit Users",
          "label_key": "system.capabilities.core.users.edit",
          "action_type": "update",
          "default_roles": ["super", "system-admin", "admin", "operator"],
          "oauth_scope": "users:write"
        },
        "verify": {
          "permission": "verify users",
          "label": "Verify User Accounts",
          "label_key": "system.capabilities.core.users.verify",
          "action_type": "update",
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "users:verify"
        },
        "delete": {
          "permission": "delete users",
          "label": "Delete Users",
          "label_key": "system.capabilities.core.users.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "users:delete"
        },
        "manage": {
          "permission": "manage users",
          "label": "Manage All Users",
          "label_key": "system.capabilities.core.users.manage",
          "action_type": "admin",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "users:manage"
        }
      }
    },
    "roles": {
      "name": "Roles & Permissions (RBAC)",
      "description": "Manage roles, permissions matrix, and authorization policies",
      "actions": {
        "view": {
          "permission": "view roles",
          "label": "View Roles",
          "label_key": "system.capabilities.core.roles.view",
          "action_type": "read",
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "roles:read"
        },
        "create": {
          "permission": "create roles",
          "label": "Create Roles",
          "label_key": "system.capabilities.core.roles.create",
          "action_type": "create",
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "roles:write"
        },
        "edit": {
          "permission": "edit roles",
          "label": "Edit Roles & Permissions",
          "label_key": "system.capabilities.core.roles.edit",
          "action_type": "update",
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "roles:write"
        },
        "delete": {
          "permission": "delete roles",
          "label": "Delete Roles",
          "label_key": "system.capabilities.core.roles.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "roles:delete"
        },
        "manage": {
          "permission": "manage roles",
          "label": "Manage All Roles",
          "label_key": "system.capabilities.core.roles.manage",
          "action_type": "admin",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "roles:manage"
        }
      }
    },
    "settings": {
      "name": "System Settings",
      "description": "General platform settings, branding identity, and parameters",
      "actions": {
        "view": {
          "permission": "view settings",
          "label": "View Settings",
          "label_key": "system.capabilities.core.settings.view",
