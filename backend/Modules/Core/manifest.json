          "label_key": "system.capabilities.core.settings.manage",
          "action_type": "manage",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin", "admin"],
          "oauth_scope": "settings:write"
        },
        "view_system": {
          "permission": "view system",
          "label": "View System Info",
          "label_key": "system.capabilities.core.settings.view_system",
          "action_type": "read",
          "default_roles": ["super", "system-admin"],
          "oauth_scope": "system:read"
        },
        "manage_system": {
          "permission": "manage system",
          "label": "Manage System Parameters",
          "label_key": "system.capabilities.core.settings.manage_system",
          "action_type": "admin",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin"],
          "oauth_scope": "system:manage"
        }
      }
    },
    "logs": {
      "name": "Audit & Activity Logs",
      "description": "Activity journals, audit trails, and system logs",
      "actions": {
        "view": {
          "permission": "view logs",
          "label": "View System Logs",
          "label_key": "system.capabilities.core.logs.view",
          "action_type": "read",
          "default_roles": ["super", "system-admin", "security-officer"],
          "oauth_scope": "logs:read"
        },
        "view_activity": {
          "permission": "view activity logs",
          "label": "View Activity Journals",
          "label_key": "system.capabilities.core.logs.view_activity",
          "action_type": "read",
          "default_roles": ["super", "system-admin", "admin", "security-officer"],
          "oauth_scope": "logs:read"
        },
        "delete": {
          "permission": "delete logs",
          "label": "Purge Logs",
          "label_key": "system.capabilities.core.logs.delete",
          "action_type": "delete",
          "is_dangerous": true,
          "default_roles": ["super", "system-admin"],
          "oauth_scope": "logs:delete"
        }
