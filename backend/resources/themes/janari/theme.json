{
    "name": "Janari",
    "slug": "janari",
    "version": "V.2.0",
    "type": "frontend",
    "description": "Janari — public marketing theme for the Jejakawan control plane (single hub, not per-customer Jejakawan).",
    "author": "Jejakawan",
    "supports": {
        "janari_canvas": true
    },
    "settings_schema": {
        "site_title": {
            "label": "Site Title",
            "type": "text",
            "default": "Jejakawan",
            "category": "General",
            "scope": "platform"
        },
        "theme_style": {
            "label": "Theme Visual Style",
            "type": "select",
            "options": [
                {
                    "label": "Clean & Minimalist",
                    "value": "clean"
                },
                {
                    "label": "Flat Modern",
                    "value": "flat"
                },
                {
                    "label": "Soft & Pastel",
                    "value": "soft"
                },
                {
                    "label": "Glassmorphism (Premium)",
                    "value": "glass"
                }
            ],
            "default": "clean",
            "category": "Appearance",
            "scope": "platform"
        },
        "brand_logo": {
            "label": "Logo",
            "type": "media",
            "category": "General",
            "scope": "platform"
        },
        "brand_favicon": {
            "label": "Favicon",
            "type": "media",
            "category": "General",
            "scope": "platform"
        },
        "site_tagline": {
            "label": "Site Tagline",
            "type": "text",
            "default": "Modern & Elegant Jejakawan",
            "category": "General",
            "scope": "platform"
        },
        "site_description": {
            "label": "Site Description",
            "type": "textarea",
            "default": "Modern Content Management System built with Laravel and Vue.js",
            "category": "General",
            "scope": "platform"
        },
        "branding_display": {
            "label": "Branding Display",
            "type": "select",
            "options": [
                {
                    "label": "Logo only",
                    "value": "logo_only"
                },
                {
                    "label": "Site name only",
                    "value": "text_only"
                },
                {
                    "label": "Logo + Site name",
                    "value": "both"
                }
            ],
            "default": "logo_only",
            "category": "General",
            "scope": "platform"
        },
        "font_heading": {
            "label": "Heading Font",
            "type": "select",
            "options": [
                {
                    "label": "Inter",
                    "value": "Inter"
                },
                {
                    "label": "Roboto",
                    "value": "Roboto"
                },
                {
                    "label": "Poppins",
                    "value": "Poppins"
                },
                {
                    "label": "Merriweather",
                    "value": "Merriweather"
                }
            ],
            "default": "Inter",
            "category": "Typography",
            "scope": "platform"
        },
        "breadcrumb_sticky": {
            "label": "Sticky Breadcrumbs",
            "type": "checkbox",
            "default": false,
            "category": "Layout",
            "description": "Keep breadcrumbs visible while scrolling",
            "scope": "platform"
        },
        "header_sticky": {
            "label": "Sticky Header",
            "type": "checkbox",
            "default": true,
            "category": "Layout",
            "scope": "platform"
        },
        "layout_style": {
            "label": "Layout Style",
            "type": "select",
            "options": [
                {
                    "label": "Full Width (Default)",
                    "value": "full"
                },
                {
                    "label": "Boxed (Content in Box)",
                    "value": "boxed"
                },
                {
                    "label": "Wide (Wider Box)",
                    "value": "wide"
                },
                {
                    "label": "Framed (Floating Box)",
                    "value": "framed"
                },
                {
                    "label": "Hybrid (Header/Footer Full)",
                    "value": "hybrid"
                }
            ],
            "default": "full",
            "category": "Layout",
            "description": "Choose overall page layout style",
            "scope": "platform"
        },
        "home_sections": {
            "label": "Homepage sections",
            "type": "checkbox_list",
            "options": [
                {
                    "label": "Landing hero",
                    "value": "hero"
                },
                {
                    "label": "Product stack",
                    "value": "products"
                },
                {
                    "label": "Hub updates",
                    "value": "updates"
                },
                {
                    "label": "Partner logos",
                    "value": "partners"
                },
                {
                    "label": "Testimonials",
                    "value": "testimonials"
                },
                {
                    "label": "Call to action",
                    "value": "cta"
                }
            ],
            "default": [
                "hero",
                "products",
                "updates",
                "partners",
                "testimonials",
                "cta"
            ],
            "category": "Layout",
            "scope": "platform"
        },
        "container_max_width": {
            "label": "Container Max Width",
            "type": "range",
            "min": 1200,
            "max": 1920,
            "step": 40,
            "default": 1400,
            "category": "Layout",
            "description": "Max width in pixels (for Boxed/Wide/Framed)",
            "scope": "platform"
        },
        "boxed_bg_color": {
            "label": "Page Background Color",
            "type": "color",
            "default": "#f1f5f9",
            "category": "Layout",
            "description": "Background visible outside boxed content",
            "scope": "platform"
        },
        "boxed_shadow": {
            "label": "Boxed Content Shadow",
            "type": "select",
            "options": [
                {
                    "label": "None",
                    "value": "none"
                },
                {
                    "label": "Subtle",
                    "value": "sm"
                },
                {
                    "label": "Medium",
                    "value": "md"
                },
                {
                    "label": "Large",
                    "value": "lg"
                },
                {
                    "label": "Extra Large",
                    "value": "xl"
                }
            ],
            "default": "lg",
            "category": "Layout",
            "scope": "platform"
        },
        "framed_padding": {
            "label": "Frame Padding",
            "type": "range",
            "min": 8,
            "max": 48,
            "step": 4,
            "default": 16,
            "category": "Layout",
            "description": "Padding around framed layout (px)",
            "scope": "platform"
        },
        "header_style": {
            "label": "Header Style",
            "type": "select",
            "options": [
                {
                    "label": "Glassmorphism",
                    "value": "glass"
                },
                {
                    "label": "Solid White",
                    "value": "solid"
                },
                {
                    "label": "Transparent",
                    "value": "transparent"
                }
            ],
            "default": "glass",
            "category": "Layout",
            "scope": "platform"
        },
        "header_cta_text": {
            "label": "Header CTA Button Text",
            "type": "text",
            "default": "Get Started",
            "category": "Layout",
            "scope": "platform"
        },
        "header_cta_url": {
            "label": "Header CTA Button URL",
            "type": "text",
            "default": "/auth/console-sign-up",
            "category": "Layout",
            "scope": "platform"
        },
        "nav_style": {
            "label": "Navigation Style",
            "type": "select",
            "options": [
                {
                    "label": "✨ Glass Morph (Blur + Transparency)",
                    "value": "glass"
                },
                {
                    "label": "🎯 Spotlight (Focus Highlight)",
                    "value": "spotlight"
                },
                {
                    "label": "🧲 Magnetic (Hover Attraction)",
                    "value": "magnetic"
                },
                {
                    "label": "💫 Floating (3D Shadow)",
                    "value": "floating"
                },
                {
                    "label": "🌊 Slide (Text Reveal)",
                    "value": "slide"
                },
                {
                    "label": "💊 Pill Modern (Soft Fill)",
                    "value": "pill"
                },
                {
                    "label": "📏 Underline Grow (Expand)",
                    "value": "underline"
                },
                {
                    "label": "🔥 Neon Glow (Cyberpunk)",
                    "value": "glow"
                }
            ],
            "default": "glass",
            "category": "Layout",
            "scope": "platform"
        },
        "button_radius": {
            "label": "Button Roundedness",
            "type": "select",
            "options": [
                {
                    "label": "Square (0px)",
                    "value": "0px"
                },
                {
                    "label": "Slight (4px)",
                    "value": "4px"
                },
                {
                    "label": "Standard (8px)",
                    "value": "8px"
                },
                {
                    "label": "Rounded (12px)",
                    "value": "12px"
                },
                {
                    "label": "Pill (Full)",
                    "value": "9999px"
                }
            ],
            "default": "8px",
            "category": "Buttons",
            "scope": "platform"
        },
        "button_border_width": {
            "label": "Button Border Width",
            "type": "range",
            "min": 0,
            "max": 4,
            "step": 1,
            "default": 1,
            "category": "Buttons",
            "scope": "platform"
        },
        "button_shadow": {
            "label": "Button Shadow",
            "type": "select",
            "options": [
                {
                    "label": "None",
                    "value": "none"
                },
                {
                    "label": "Subtle",
                    "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
                },
                {
                    "label": "Medium",
                    "value": "0 4px 6px -1px rgb(0 0 0 / 0.1)"
                },
                {
                    "label": "Strong",
                    "value": "0 10px 15px -3px rgb(0 0 0 / 0.1)"
                },
                {
                    "label": "Glow (Primary)",
                    "value": "0 0 15px var(--theme-primary-color)"
                }
            ],
            "default": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
            "category": "Buttons",
            "scope": "platform"
        },
        "disabled_page_behavior": {
            "label": "When a page is turned off",
            "type": "select",
            "options": [
                {
                    "label": "Redirect to Home",
                    "value": "redirect"
                },
                {
                    "label": "Show Maintenance Message",
                    "value": "message"
                }
            ],
            "default": "message",
            "category": "Public Pages",
            "scope": "platform"
        },
        "disabled_page_message": {
            "label": "Message shown to visitors",
            "type": "textarea",
            "default": "This page is temporarily unavailable while we improve the experience. Please check back soon.",
            "category": "Public Pages",
            "scope": "platform"
        },
        "enable_about": {
            "label": "Show About page",
            "type": "checkbox",
            "default": true,
            "category": "Public Pages",
            "scope": "platform"
        },
        "enable_achievement": {
            "label": "Show Achievements page",
            "type": "checkbox",
            "default": true,
            "category": "Public Pages",
            "scope": "platform"
        },
        "enable_career": {
            "label": "Show Careers page",
            "type": "checkbox",
            "default": true,
            "category": "Public Pages",
            "scope": "platform"
        },
        "enable_blog": {
            "label": "Show News page",
            "type": "checkbox",
            "default": true,
            "category": "Public Pages",
            "scope": "platform"
        },
        "enable_contact": {
            "label": "Show Contact page",
            "type": "checkbox",
            "default": true,
            "category": "Public Pages",
            "scope": "platform"
        },
        "footer_text": {
            "label": "Copyright Text",
            "type": "text",
            "default": "© 2026 Jejakawan. All rights reserved.",
            "category": "Footer",
            "scope": "platform"
        },
        "back_to_top": {
            "label": "Enable Back to Top",
            "type": "checkbox",
            "default": true,
            "category": "Footer",
            "scope": "platform"
        },
        "social_links": {
            "label": "Social Media Links",
            "type": "repeater",
            "category": "Social Media",
            "fields": [
                {
                    "name": "icon",
                    "label": "Platform",
                    "type": "select",
                    "options": "social_icons"
                },
                {
                    "name": "url",
                    "label": "URL",
                    "type": "text"
                }
            ],
            "default": [
                {
                    "icon": "Twitter",
                    "url": "https://twitter.com/jejakawan"
                },
                {
                    "icon": "Instagram",
                    "url": "https://instagram.com/jejakawan"
                },
                {
                    "icon": "Github",
                    "url": "https://github.com/jejakawan/k2net"
                }
            ],
            "scope": "platform"
        },
        "animation_enabled": {
            "label": "Enable GSAP Animations",
            "type": "boolean",
            "default": true,
            "category": "Animations",
            "scope": "platform"
        },
        "animation_intensity": {
            "label": "Animation Intensity",
            "type": "select",
            "options": [
                {
                    "label": "Subtle (Halus)",
                    "value": "subtle"
                },
                {
                    "label": "Normal",
                    "value": "normal"
                },
                {
                    "label": "Dramatic (Dramatis)",
                    "value": "dramatic"
                }
            ],
            "default": "normal",
            "category": "Animations",
            "scope": "platform"
        },
        "parallax_enabled": {
            "label": "Enable Parallax Effects",
            "type": "boolean",
            "default": true,
            "category": "Animations",
            "scope": "platform"
        },
        "color_preset": {
            "label": "Color Preset",
            "type": "select",
            "default": "custom",
            "category": "Colors",
            "description": "Quick apply curated color combinations. You can still tweak colors manually.",
            "options": [
                {
                    "label": "Custom (Manual)",
                    "value": "custom"
                },
                {
                    "label": "Monochrome Clean",
                    "value": "monochrome_clean"
                },
                {
                    "label": "Oceanic Clean",
                    "value": "oceanic_clean"
                },
                {
                    "label": "Emerald Fresh",
                    "value": "emerald_fresh"
                },
                {
                    "label": "Royal Violet",
                    "value": "royal_violet"
                },
                {
                    "label": "Sunset Coral",
                    "value": "sunset_coral"
                },
                {
                    "label": "Midnight Cyan",
                    "value": "midnight_cyan"
                },
                {
                    "label": "Forest Earth",
                    "value": "forest_earth"
                },
                {
                    "label": "Ruby Night",
                    "value": "ruby_night"
                },
                {
                    "label": "Aurora Mint",
                    "value": "aurora_mint"
                },
                {
                    "label": "Slate Indigo",
                    "value": "slate_indigo"
                },
                {
                    "label": "Arctic Blue",
                    "value": "arctic_blue"
                },
                {
                    "label": "Sand Stone",
                    "value": "sand_stone"
                }
            ],
            "scope": "theme"
        },
        "color_intensity": {
            "label": "Palette Intensity",
            "type": "select",
            "default": "balanced",
            "category": "Colors",
            "description": "Controls how strong the global color tint appears across cards, borders, accents, and surfaces.",
            "options": [
                {
                    "label": "Soft",
                    "value": "soft"
                },
                {
                    "label": "Balanced",
                    "value": "balanced"
                },
                {
                    "label": "Vibrant",
                    "value": "vibrant"
                }
            ],
            "scope": "theme"
        },
        "monochrome_variant": {
            "label": "Monochrome Base Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Control black/white base depth for light/dark mode while accent color stays separate.",
            "options": [
                {
                    "label": "Clean",
                    "value": "clean"
                },
                {
                    "label": "Soft Contrast",
                    "value": "soft"
                },
                {
                    "label": "Matte",
                    "value": "matte"
                },
                {
                    "label": "High Contrast",
                    "value": "high_contrast"
                }
            ],
            "scope": "theme"
        },
        "monochrome_texture": {
            "label": "Surface Texture",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Add subtle texture pattern over page background. Works with all presets.",
            "options": [
                {
                    "label": "Clean (No Texture)",
                    "value": "clean"
                },
                {
                    "label": "Dot Matrix",
                    "value": "dots"
                },
                {
                    "label": "Fine Grain",
                    "value": "grain"
                }
            ],
            "scope": "theme"
        },
        "monochrome_texture_strength": {
            "label": "Texture Strength",
            "type": "range",
            "min": 0,
            "max": 35,
            "step": 1,
            "default": 8,
            "category": "Colors",
            "description": "Lower for subtle premium effect, higher for visible texture.",
            "scope": "theme"
        },
        "color_primary": {
            "label": "Primary Color",
            "type": "color",
            "default": "#1e40af",
            "category": "Colors",
            "scope": "theme"
        },
        "color_background": {
            "label": "Background Color (stored)",
            "type": "color",
            "default": "#f9fafb",
            "category": "Colors",
            "hidden": true,
            "description": "Hidden; light/dark backgrounds use bg_light_color / bg_dark_color in the customizer.",
            "scope": "theme"
        },
        "bg_light_color": {
            "label": "Light Mode Background",
            "type": "select",
            "default": "white",
            "category": "Colors",
            "description": "Base background color for light mode.",
            "options": [
                {
                    "label": "⬜ White (Default)",
                    "value": "white"
                },
                {
                    "label": "🟡 Cream / Ivory",
                    "value": "cream"
                },
                {
                    "label": "🔵 Cool Gray",
                    "value": "cool_gray"
                },
                {
                    "label": "🟠 Warm Gray",
                    "value": "warm_gray"
                },
                {
                    "label": "🟢 Mint",
                    "value": "mint"
                },
                {
                    "label": "🟣 Lavender",
                    "value": "lavender"
                },
                {
                    "label": "🔴 Blush / Rose",
                    "value": "blush"
                },
                {
                    "label": "🔵 Sky",
                    "value": "sky"
                },
                {
                    "label": "🟡 Sand",
                    "value": "sand"
                }
            ],
            "scope": "theme"
        },
        "bg_light_variant": {
            "label": "Light Background Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Fine-tune the light background tone.",
            "options": [
                {
                    "label": "Clean (Pure)",
                    "value": "clean"
                },
                {
                    "label": "Soft",
                    "value": "soft"
                },
                {
                    "label": "Matte",
                    "value": "matte"
                },
                {
                    "label": "Warm",
                    "value": "warm"
                }
            ],
            "scope": "theme"
        },
        "bg_dark_color": {
            "label": "Dark Mode Background",
            "type": "select",
            "default": "black",
            "category": "Colors",
            "description": "Base background color for dark mode.",
            "options": [
                {
                    "label": "⬛ Black (Default)",
                    "value": "black"
                },
                {
                    "label": "🔘 Charcoal",
                    "value": "charcoal"
                },
                {
                    "label": "🔵 Navy",
                    "value": "navy"
                },
                {
                    "label": "🔘 Slate",
                    "value": "slate"
                },
                {
                    "label": "🟢 Forest",
                    "value": "forest"
                },
                {
                    "label": "🔴 Wine / Burgundy",
                    "value": "wine"
                },
                {
                    "label": "🔵 Midnight",
                    "value": "midnight"
                },
                {
                    "label": "🟣 Dark Plum",
                    "value": "plum"
                },
                {
                    "label": "🟠 Dark Earth",
                    "value": "earth"
                }
            ],
            "scope": "theme"
        },
        "bg_dark_variant": {
            "label": "Dark Background Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Fine-tune the dark background tone.",
            "options": [
                {
                    "label": "Clean (Pure)",
                    "value": "clean"
                },
                {
                    "label": "Soft",
                    "value": "soft"
                },
                {
                    "label": "Matte",
                    "value": "matte"
                },
                {
                    "label": "Deep",
                    "value": "deep"
                }
            ],
            "scope": "theme"
        },
        "hero_title": {
            "label": "Hero Title (fallback)",
            "type": "text",
            "default": "JEJAKAWAN",
            "category": "Hero Section",
            "description": "Used when locale-specific titles below are empty.",
            "scope": "theme"
        },
        "hero_title_en": {
            "label": "Hero Title (English)",
            "type": "text",
            "default": "JEJAKAWAN",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_title_id": {
            "label": "Hero Title (Indonesian)",
            "type": "text",
            "default": "JEJAKAWAN",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_subtitle": {
            "label": "Hero Subtitle (fallback)",
            "type": "textarea",
            "default": "Jejakawan editorial, tema Janari, dan operasi platform dalam satu hub.",
            "category": "Hero Section",
            "description": "Used when locale-specific subtitles below are empty.",
            "scope": "theme"
        },
        "hero_subtitle_en": {
            "label": "Hero Subtitle (English)",
            "type": "textarea",
            "default": "Editorial Jejakawan, Janari theme, and platform operations in one hub.",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_subtitle_id": {
            "label": "Hero Subtitle (Indonesian)",
            "type": "textarea",
            "default": "Jejakawan editorial, tema Janari, dan operasi platform dalam satu hub.",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_slide_count": {
            "label": "Number of Slides",
            "type": "range",
            "min": 1,
            "max": 5,
            "step": 1,
            "default": 3,
            "category": "Hero Section",
            "description": "How many background slides to show in the hero carousel",
            "scope": "theme"
        },
        "hero_slide_interval": {
            "label": "Slide Interval (seconds)",
            "type": "range",
            "min": 3,
            "max": 15,
            "step": 1,
            "default": 6,
            "category": "Hero Section",
            "description": "Auto-play interval between slides",
            "scope": "theme"
        },
        "hero_slide_1": {
            "label": "Slide 1 Image",
            "type": "media",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_slide_2": {
            "label": "Slide 2 Image",
            "type": "media",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_slide_3": {
            "label": "Slide 3 Image",
            "type": "media",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_slide_4": {
            "label": "Slide 4 Image",
            "type": "media",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_slide_5": {
            "label": "Slide 5 Image",
            "type": "media",
            "category": "Hero Section",
            "scope": "theme"
        },
        "hero_overlay_opacity": {
            "label": "Overlay Darkness",
            "type": "range",
            "min": 10,
            "max": 90,
            "step": 5,
            "default": 50,
            "category": "Hero Section",
            "description": "Darkness of the overlay on hero images (higher = darker)",
            "scope": "theme"
