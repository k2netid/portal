{
    "name": "Zenith",
    "slug": "zenith",
    "version": "1.0.0",
    "type": "frontend",
    "description": "Zenith — ultra-clean, modern minimalist theme for high-performance SaaS, corporate, agency, and creator publications.",
    "author": "Jejakawan Team",
    "supports": {
        "zenith_canvas": true
    },
    "settings_schema": {
        "site_title": {
            "label": "Site Title",
            "type": "text",
            "default": "Zenith Modern",
            "category": "General",
            "scope": "platform"
        },
        "brand_logo": {
            "label": "Logo",
            "type": "media",
            "category": "General",
            "scope": "platform"
        },
        "brand_favicon": {
            "label": "Favicon",
            "type": "media",
            "category": "General",
            "scope": "platform"
        },
        "color_primary": {
            "label": "Primary Accent Color",
            "type": "color",
            "default": "#2563eb",
            "category": "Colors"
        },
        "color_secondary": {
            "label": "Secondary Color",
            "type": "color",
            "default": "#475569",
            "category": "Colors"
        },
        "font_heading": {
            "label": "Heading Font",
            "type": "font",
            "default": "Plus Jakarta Sans",
            "category": "Typography"
        },
        "font_body": {
            "label": "Body Font",
            "type": "font",
            "default": "Inter",
            "category": "Typography"
        },
        "hero_badge_text": {
            "label": "Hero Badge Text",
            "type": "text",
            "default": "Introducing Zenith 1.0",
            "category": "Hero Section"
        },
        "hero_title": {
            "label": "Hero Title",
            "type": "text",
            "default": "Modern digital experiences built with precision and speed.",
            "category": "Hero Section"
        },
        "hero_subtitle": {
            "label": "Hero Subtitle",
            "type": "textarea",
            "default": "Empower your brand with cutting-edge performance, clean aesthetics, and effortless content management.",
            "category": "Hero Section"
        },
        "hero_primary_cta_text": {
            "label": "Primary CTA Label",
            "type": "text",
            "default": "Explore Showcase",
            "category": "Hero Section"
        },
        "hero_primary_cta_link": {
            "label": "Primary CTA Link",
            "type": "text",
            "default": "/blog",
            "category": "Hero Section"
        },
        "footer_copyright": {
            "label": "Footer Copyright",
            "type": "text",
            "default": "© 2026 Zenith. All rights reserved.",
            "category": "Footer"
        }
    }
}
