APP_NAME=Jejakawan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_INSTALLED=false

# unified | ops | tenant — see docs/operational/deploy-app-role.md
# APP_ROLE=unified

# CSP staged rollout:
# - true  : collect violations without blocking
# - false : enforce CSP policy
CSP_REPORT_ONLY=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PHPUnit often uses sqlite (see phpunit.xml). Jejakawan hosted production:
# DB_CONNECTION=pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ja_sas
# DB_USERNAME=ja_sas_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Jejakawan"
VITE_API_URL="${APP_URL}"
VITE_ROOT_DOMAIN="localhost"
VITE_PORTAL_URL="${APP_URL}"
VITE_SESSION_LIFETIME="28800"

# Comma-separated emails to auto-assign role `security-officer`
# Example: SECURITY_OFFICER_EMAILS=secops@example.com,itlead@example.com
SECURITY_OFFICER_EMAILS=

# Optional alert threshold overrides (useful per environment)
# Production suggestion: 5 / 3 / 10 / 60
# Staging suggestion: 8 / 4 / 14 / 90
# Local/testing suggestion: 15 / 6 / 25 / 120
SECURITY_ALERT_FAILED_LOGIN_THRESHOLD=
SECURITY_ALERT_BLOCKED_IP_THRESHOLD=
SECURITY_ALERT_SUSPICIOUS_IP_THRESHOLD=
SECURITY_ALERT_WINDOW_MINUTES=

# CMS: relative path from backend/ to Vue theme folders (monorepo default)
# CMS_THEME_VIEWS_RELATIVE_PATH=../frontend/src/modules/Cms/views/themes

# --- SaaS payment (see docs/operational/env/saas-payment.*.example) ---
# SAAS_PAYMENT_CHECKOUT_STUB=true
# SAAS_PAYMENT_WEBHOOK_SKIP_VERIFY=false
# SAAS_PAYMENT_INTERNAL_WEBHOOK_TOKEN=
# MIDTRANS_ENABLED=false
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# XENDIT_ENABLED=false
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
# Verify: php artisan saas:payment-env-check --profile=staging

# --- SaaS tenant provisioning (PostgreSQL — stub until API URL set) ---
# SAAS_PROVISIONING_ENABLED=true
# SAAS_PROVISIONING_STUB=false
# SAAS_PROVISIONING_API_URL=https://provisioner.example.com/v1/tenants
# SAAS_PROVISIONING_API_TOKEN=
# SAAS_PROVISIONING_DB_PREFIX=jejakawan_tenant_
# SAAS_PROVISIONING_LOCAL_PG=true
# SAAS_PROVISIONING_PG_ADMIN_DB=postgres
# php artisan saas:provision-tenant-databases
# Check: ../scripts/check-hosted-stack.sh

# =============================================================================
# SECURITY CONFIGURATION (Added: Security Audit Fixes)
# =============================================================================
# [SECURITY FIX H-02] Content Security Policy
# Leave empty to use auto-generated nonce-based CSP (recommended).
# Only set if you need a fully custom policy.
# CSP_POLICY=

# [SECURITY FIX H-02] CSP Report-Only mode (recommended during nonce migration)
# Set to true to report violations without enforcing them.
# CSP_REPORT_ONLY=false

# [SECURITY FIX L-01] Extra connect-src domains (comma-separated)
# Add external domains your frontend needs to connect to (e.g. tenant portals).
# Example: CSP_CONNECT_EXTRA="https://tenant1.example.com,https://tenant2.example.com"
# CSP_CONNECT_EXTRA=

# =============================================================================
# PRODUCTION SECURITY REMINDERS
# =============================================================================
# CRITICAL: Ensure the following are set correctly in production:
#   APP_DEBUG=false           (prevents stack traces being exposed)
#   APP_ENV=production        (enables production optimizations)
#   LOG_LEVEL=warning         (reduces log noise and sensitive data in logs)
#   SESSION_SECURE_COOKIE=true (ensures session cookie is HTTPS-only)
# Remote plugin theme blocks.js (off by default)
# FEATURE_REMOTE_PLUGIN_BLOCKS=false
# THEME_REMOTE_BLOCK_HOSTS=cdn.example.com
# IAM / Integrations
SCIM_TOKEN=
LOG_SIEM_LEVEL=info
SIEM_URL=


# Accounting (Slice 6 AR — off until journal v1)
ACCOUNTING_AR_INVOICES_ENABLED=false
ACCOUNTING_PERIOD_ENFORCEMENT=true
ACCOUNTING_FX_RATE_USD=16000
ACCOUNTING_INVOICE_REMINDER_EMAIL=finance@example.com

# SME (Moodle) licensed update manifests — stamp 2026-07-26_18-35 S4 / D3
# SME_UPDATE_HMAC_SECRET=
# SME_RELEASE_MANIFEST_STABLE=/var/www/ja-control-plane/storage/app/sme-releases/stable/manifest.json
# SME_RELEASE_MANIFEST_BETA=
# SME_RELEASE_PACKAGE_STABLE=
# SME_RELEASE_PACKAGE_BETA=
# SME_RELEASE_GATE_DOWNLOADS=false
# SME_RELEASE_PACKAGE_TOKEN_TTL=900

# SME license verification — stamp 2026-07-26_22-09
# Signs POST /api/v1/license/verify response; exposed to customers as "Portal response signing secret"
# SME_RESPONSE_SIGNING_SECRET=
# Signs offline .jklic payload (JK1 key); exposed to customers as "Offline HMAC secret"
# SME_OFFLINE_LICENSE_HMAC_SECRET=

# Aksara (ExamForge) — push entitlement (NOT license/verify)
# AKSARA_API_URL=https://api-aksara.jejakawan.com
# AKSARA_APP_URL=https://aksarakita.jejakawan.com
# Shared with ja-aksara PORTAL_ENTITLEMENT_SECRET
# AKSARA_ENTITLEMENT_SECRET=
# Exambro APK — member CTA download links
# EXAMBRO_DOWNLOAD_URL=https://github.com/jejak-awan/ja-exambro/releases
# EXAMBRO_DOCS_URL=https://github.com/jejak-awan/ja-exambro/blob/android/README.md
