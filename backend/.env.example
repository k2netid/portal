APP_NAME=Jejakawan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_INSTALLED=false

# Super Admin seeding credentials (used by db:seed)
# If SUPER_ADMIN_PASSWORD is not set, a random password will be generated.
# SUPER_ADMIN_EMAIL=admin@your-domain.com
# SUPER_ADMIN_PASSWORD=

# unified | ops | tenant — see docs/operational/deploy-app-role.md
# APP_ROLE=unified

# CSP staged rollout:
# - true  : collect violations without blocking (use during initial testing)
# - false : enforce CSP policy (REQUIRED for production)
CSP_REPORT_ONLY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PHPUnit often uses sqlite (see phpunit.xml). Jejakawan hosted production:
# DB_CONNECTION=pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ja_sas
# DB_USERNAME=ja_sas_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Jejakawan"
VITE_API_URL="${APP_URL}"
VITE_ROOT_DOMAIN="localhost"
VITE_PORTAL_URL="${APP_URL}"
VITE_SESSION_LIFETIME="28800"

# Comma-separated emails to auto-assign role `security-officer`
# Example: SECURITY_OFFICER_EMAILS=secops@example.com,itlead@example.com
SECURITY_OFFICER_EMAILS=

# Optional alert threshold overrides (useful per environment)
# Production suggestion: 5 / 3 / 10 / 60
# Staging suggestion: 8 / 4 / 14 / 90
# Local/testing suggestion: 15 / 6 / 25 / 120
SECURITY_ALERT_FAILED_LOGIN_THRESHOLD=
SECURITY_ALERT_BLOCKED_IP_THRESHOLD=
SECURITY_ALERT_SUSPICIOUS_IP_THRESHOLD=
SECURITY_ALERT_WINDOW_MINUTES=

# CMS: relative path from backend/ to Vue theme folders (monorepo default)
# CMS_THEME_VIEWS_RELATIVE_PATH=../frontend/src/modules/Content/Layout/views/themes

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Content Security Policy
# Leave empty to use auto-generated nonce-based CSP (recommended).
# Only set if you need a fully custom policy.
# CSP_POLICY=

# CSP Report-Only mode (recommended during initial setup)
# Set to true to report violations without enforcing them.
# CSP_REPORT_ONLY=false

# Extra connect-src domains (comma-separated)
# CSP_CONNECT_EXTRA=

# =============================================================================
# PRODUCTION SECURITY REMINDERS
# =============================================================================
# CRITICAL: Ensure the following are set correctly in production:
#   APP_DEBUG=false           (prevents stack traces being exposed)
#   APP_ENV=production        (enables production optimizations)
#   LOG_LEVEL=warning         (reduces log noise and sensitive data in logs)
#   SESSION_SECURE_COOKIE=true (ensures session cookie is HTTPS-only)
# Remote plugin theme blocks.js (off by default)
# FEATURE_REMOTE_PLUGIN_BLOCKS=false
# THEME_REMOTE_BLOCK_HOSTS=cdn.example.com
# IAM / Integrations
SCIM_TOKEN=
LOG_SIEM_LEVEL=info
SIEM_URL=

