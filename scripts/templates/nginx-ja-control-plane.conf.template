# Jejakawan control plane (SPA + Laravel API) — listen {{PORT}}
server {
    listen {{PORT}};
    server_name {{SERVER_NAME}};
    root {{APP_PATH}}/backend/public;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.html index.php;
    charset utf-8;

    # API & Sanctum — never fall back to SPA HTML for missing JSON routes
    location ~ ^/(api|sanctum) {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP processing (Laravel front controller)
    location ~ \.php$ {
        fastcgi_pass {{PHP_FPM_SOCK}};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Vite build output — missing chunk must NOT return HTML (avoids MIME type errors)
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }


    location = /theme-prepaint.js {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Entry shell — always revalidate after deploy
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri =404;
    }

    # Other static files (favicon, etc.)
    location ~* \.(css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|webm|mp4)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    # SPA + Laravel fallback (public routes → index.html via Laravel)
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
