# Jejakawan Nginx Template (Based on Production Config)
server {
    listen 80;
    server_name {{DOMAIN}};
    
    # Redirect HTTP to HTTPS (Optional, can be enabled after SSL setup)
    # return 301 https://$server_name$request_uri;

    root {{APP_PATH}}/frontend/dist;
    index index.html index.php;

    charset utf-8;

    # Backend API Handler (do not rewrite API 404s to the public SPA index.html)
    location /api {
        root {{APP_PATH}}/backend/public;
        fastcgi_intercept_errors off;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /sanctum {
        root {{APP_PATH}}/backend/public;
        fastcgi_intercept_errors off;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Global PHP Handler for Laravel
    location ~ \.php$ {
        root {{APP_PATH}}/backend/public;
        fastcgi_pass {{PHP_FPM_SOCK}};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
        # fastcgi_param HTTPS on; # Enable if SSL is used
    }

    # SPA Catch-all
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Storage access
    location /storage {
        alias {{APP_PATH}}/backend/storage/app/public;
        try_files $uri =404;
        access_log off;
    }

    location = /favicon.ico { root {{APP_PATH}}/backend/public; access_log off; log_not_found off; }
    location = /robots.txt  { root {{APP_PATH}}/backend/public; access_log off; log_not_found off; }

    error_page 404 /index.html;

    location ~ /\.ht {
        deny all;
    }
}
