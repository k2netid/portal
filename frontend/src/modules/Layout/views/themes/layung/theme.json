            "options": [
                {
                    "label": "Landing hero",
                    "value": "hero"
                },
                {
                    "label": "Bento Infrastructure & Services",
                    "value": "services"
                },
                {
                    "label": "Bandwidth & Speed Calculator",
                    "value": "calculator"
                },
                {
                    "label": "SLA Performance Guarantee",
                    "value": "sla"
                },
                {
                    "label": "Managed IT & SOC Services",
                    "value": "managed_services"
                },
                {
                    "label": "Client Testimonials & Partners",
                    "value": "testimonials"
                },
                {
                    "label": "Technical & Provisioning FAQ",
                    "value": "faq"
                },
                {
                    "label": "Call to action (CTA)",
                    "value": "cta"
                }
