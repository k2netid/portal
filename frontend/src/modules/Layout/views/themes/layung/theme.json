            "label": "Theme Visual Style",
            "type": "select",
            "options": [
                {
                    "label": "Clean & Minimalist",
                    "value": "clean"
                },
                {
                    "label": "Flat Modern",
                    "value": "flat"
                },
                {
                    "label": "Soft & Pastel",
                    "value": "soft"
                },
                {
                    "label": "Glassmorphism (Premium)",
                    "value": "glass"
                }
            ],
            "default": "clean",
            "category": "Appearance",
            "scope": "platform"
        },
        "brand_logo": {
            "label": "Logo",
            "type": "media",
            "category": "General",
            "scope": "platform"
        },
        "brand_favicon": {
            "label": "Favicon",
            "type": "media",
            "category": "General",
            "scope": "platform"
