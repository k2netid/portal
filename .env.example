# Jejakawan Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.

APP_NAME="Jejakawan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-domain.com
APP_ROOT_DOMAIN=your-domain.com
APP_INSTALLED=false

# Deploy plane: unified (pilot) | ops | tenant — docs/operational/deploy-app-role.md
APP_ROLE=unified

# Locale Settings
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Security & Proxies
TRUSTED_PROXIES=127.0.0.1,::1
CSP_REPORT_ONLY=false

# Database Configuration (PostgreSQL recommended)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ja_platform_db
DB_USERNAME=ja_user
DB_PASSWORD=

# Session & Cache (Redis recommended for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

CACHE_STORE=redis
CACHE_PREFIX=ja_apps_

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PASSWORD=null
REDIS_PREFIX=ja_apps_

# Filesystem
FILESYSTEM_DISK=local

# Sanctum for SPA Authentication
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Frontend (Vite) Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
VITE_ROOT_DOMAIN="${APP_ROOT_DOMAIN}"

# Security Officer Notification
SECURITY_OFFICER_EMAILS=
# IAM / Integrations
SCIM_TOKEN=
LOG_SIEM_LEVEL=info
SIEM_URL=


# CRM email sequences (use smtp/sendmail in production)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Jejakawan"
