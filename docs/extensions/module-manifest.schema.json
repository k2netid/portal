{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jejakawan.local/schemas/module-manifest.schema.json",
  "title": "Jejakawan first-party / plugin manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "slug", "version", "type", "is_core", "author", "description"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "minLength": 1,
      "maxLength": 100
    },
    "version": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["module", "plugin"] },
    "family": {
      "type": "string",
      "enum": ["platform", "cms", "communications", "module", "plugin"]
    },
    "parent_slug": { "type": "string" },
    "is_core": { "type": "boolean" },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "license_tier": { "type": "string", "enum": ["free", "pro", "pro_plus"] },
    "settings_route": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "suggests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name"],
        "additionalProperties": true,
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Spatie permission names for console operators; seeded on activate, never deleted on deactivate"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "actions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "actions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["permission"],
              "properties": {
                "permission": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "label_key": { "type": "string" },
                "action_type": {
                  "type": "string",
                  "enum": ["read", "create", "update", "delete", "execute", "manage", "admin"]
                },
                "default_roles": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "oauth_scope": { "type": "string" },
                "is_dangerous": { "type": "boolean" }
              }
            }
          }
        }
      },
      "description": "Structured capability and permission matrix defining features, actions, default role assignments, and OAuth2 scopes"
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "description": "Idempotent activate/deactivate seeders — see docs/extensions/rbac-and-lifecycle-seeders.md",
      "properties": {
        "preserve_data_on_deactivate": { "type": "boolean", "default": true },
        "seeders_on_activate": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "seeders_on_deactivate": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "member_area": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reader portal contributions when member + pack are product-active — see docs/extensions/member-area.md",
      "properties": {
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nav": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["slug"],
            "properties": {
              "slug": { "type": "string", "minLength": 1 },
              "route": { "type": "string" },
              "capability": { "type": "string" },
              "requires_verified": { "type": "boolean" },
              "order": { "type": "integer" }
            }
          }
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["slug"],
            "properties": {
              "slug": { "type": "string", "minLength": 1 },
              "slot": { "type": "string" },
              "capability": { "type": "string" },
              "order": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
