# OS/editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
.envrc
core
core.*

# Local / one-off scripts (not part of release tooling)
drop_sch.sh
drop_sch_sas.sh
releases/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!backend/.env.example
*.key
*.pem
*.sql
backend/.env
frontend/.env
